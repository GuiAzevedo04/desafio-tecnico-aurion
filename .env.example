# Local development defaults. Copy this file to .env and adjust if needed:
#   cp .env.example .env
# Use real secrets outside local development and never commit the .env file.

# Host port where the API is published (http://localhost:3000).
API_PORT=3000

# PostgreSQL credentials, used by both the database and the API containers.
POSTGRES_USER=ordens
POSTGRES_PASSWORD=ordens_dev_local
POSTGRES_DB=ordens
